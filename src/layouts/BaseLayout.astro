---
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cri Works — Product Designer',
	description = 'Shaping clarity for tech-driven startups through thoughtful product design.',
} = Astro.props;

const pageTitle = Astro.url.pathname === '/' ? title : `${title} · Cri Works`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body class="min-h-dvh bg-background text-foreground antialiased">
	        <slot />
	        <script>
	                import { initLenis } from '@/lib';
	                initLenis();
	        </script>
	</body></html>
