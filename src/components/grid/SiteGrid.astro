---
/**
 * 16-column stretch grid aligned with Figma layout specs:
 * - margin: 16px (padding-inline on the grid)
 * - gutter: 16px (column-gap)
 * - columns: 16 × minmax(0, 1fr)
 *
 * Place direct children with .site-col-start-{n} + .site-col-span-{m} (always both).
 * Prefixed to avoid Tailwind's col-span shorthand. Full width: site-col-start-1 site-col-span-16
 */
interface Props {
	tag?: keyof HTMLElementTagNameMap;
	class?: string;
}

const { tag: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['site-grid', className]}>
	<slot />
</Tag>
