---

<div
  id="splash-loader"
  aria-hidden="true"
  class="fixed inset-0 z-splash flex items-start justify-center overflow-hidden bg-background"
>
  <!-- Pill — adjust mt-65 to move vertically -->
  <div
    id="splash-pill"
    class="relative z-[1] mt-65 flex items-center gap-1.5 rounded-full bg-foreground/10 py-2 pl-2 pr-3"
  >
    <!-- Progress circle -->
    <div class="size-5 shrink-0">
      <svg
        viewBox="0 0 20 20"
        width="20"
        height="20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Static track ring -->
        <circle
          cx="10"
          cy="10"
          r="8"
          style="stroke: var(--color-accent-base)"
          stroke-width="2"
          stroke-opacity="0.25"></circle>
        <!-- Progress arc: clockwise from top, animated via strokeDashoffset -->
        <circle
          id="splash-arc"
          cx="10"
          cy="10"
          r="8"
          style="stroke: var(--color-accent-base)"
          stroke-width="2"
          stroke-linecap="round"
          transform="rotate(-90 10 10)"
          stroke-dasharray="50.2655"
          stroke-dashoffset="50.2655"></circle>
      </svg>
    </div>

    <!-- Label -->
    <span class="font-sans text-base font-medium leading-none whitespace-nowrap text-accent-base">
      Cargando... <span id="splash-pct">0</span>%
    </span>
  </div>

  <!-- Floating image — wrapper uses no CSS transform so GSAP y is clean -->
  <div
    id="splash-img-wrap"
    class="pointer-events-none absolute -bottom-[10%] left-0 right-0 flex justify-center"
  >
    <img
      src="/images/cri-colored-new-techblue-back-blured.png"
      alt=""
      class="block h-[80dvh] w-auto max-w-none object-cover"
    />
  </div>
</div>
