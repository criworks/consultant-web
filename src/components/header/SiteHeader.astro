---
import { site } from '@/data'
import { Circle, Mail } from '@lucide/astro'
---

<header
  class="site-col-start-1 site-col-span-32 grid grid-cols-[repeat(var(--grid-columns),minmax(0,1fr))] gap-(--grid-gutter) pt-10"
>
  <!-- Nav: primary links + freelance status -->
  <div class="site-col-start-1 site-col-span-3 flex gap-4 items-start" data-animate="hero-nav">
    <nav class="flex flex-col gap-11.5" aria-label="Primary">
      {
        site.nav.map(item => (
          <a
            href={item.href}
            class="flex items-center gap-3 text-base font-semibold text-foreground transition-opacity hover:opacity-80"
            aria-current={item.active ? 'page' : undefined}
          >
            {item.active && (
              <Circle size={10} fill="currentColor" stroke-width={0} class="shrink-0" />
            )}
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- Freelance status — col 4-8, baseline-aligned with first nav item -->
  <div class="flex items-start gap-3 site-col-start-4 site-col-span-5" data-animate="hero-status">
    <Circle size={10} fill="currentColor" stroke-width={0} class="shrink-0 text-accent" />
    <span class="text-base font-semibold text-accent">Freelance</span>
    <span class="text-base font-semibold text-accent opacity-60 cursor-default">Contractor</span>
  </div>

  <!-- Contact -->
  <a
    href={`mailto:${site.email}`}
    class="site-col-start-29 site-col-span-4 flex items-start justify-end gap-2 text-base font-semibold text-foreground"
    data-animate="hero-contact"
  >
    <Mail size={14} stroke-width={1.5} class="shrink-0" />
    {site.email}
  </a>
</header>
