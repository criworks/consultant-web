---
import { site } from '@/data'
import { Mail } from '@lucide/astro'
import { Button, Link } from '@/components/ui'

// Email split so neither the address nor mailto: appears in the HTML.
// JS assembles and displays it — bots that don't execute JS never see it.
const [emailUser, emailDomain] = site.email.split('@')
---

<header
  class="site-col-start-1 site-col-span-32 grid grid-cols-[repeat(var(--grid-columns),minmax(0,1fr))] gap-(--grid-gutter) pt-10"
>
  <!-- Nav: primary links + freelance status -->
  <div class="site-col-start-1 site-col-span-3 flex gap-4 items-start" data-animate="hero-nav">
    <nav class="flex flex-col gap-11.5" aria-label="Primary">
      {
        site.nav.map(item => (
          <Link variant="secondary" label={item.label} href={item.href} active={item.active} />
        ))
      }
    </nav>
  </div>

  <!-- Freelance status -->
  <div class="flex items-start gap-3 site-col-start-4 site-col-span-5" data-animate="hero-status">
    <Link variant="tertiary" label="Freelance" href="#" active={true} />
    <Link variant="tertiary" label="Contractor" href="#" active={false} />
  </div>

  <!-- Contact: copy-to-clipboard — no mailto: or email address in the HTML -->
  <Button
    variant="secondary"
    icon={Mail}
    iconSize={14}
    id="contact-email-btn"
    data-u={emailUser}
    data-d={emailDomain}
    class="site-col-start-29 site-col-span-4 flex items-start justify-end"
    data-animate="hero-contact"
    aria-label="Copiar email de contacto"
  >
    <span id="contact-email-label"></span>
  </Button>
</header>

<!-- Toast: fixed pill, positioned and animated entirely by GSAP -->
<div
  id="email-copied-toast"
  role="status"
  aria-live="polite"
  class="fixed bottom-8 z-50 pointer-events-none"
  style="left: 50%; opacity: 0;"
>
  <div
    class="bg-foreground text-background text-sm font-semibold px-4 py-2.5 rounded-full whitespace-nowrap"
  >
    Email copiado
  </div>
</div>

<script>
  import { gsap } from '@/lib'

  const btn = document.getElementById('contact-email-btn') as HTMLButtonElement | null
  const label = document.getElementById('contact-email-label')
  const toast = document.getElementById('email-copied-toast')

  if (btn && label) {
    const email = `${btn.dataset.u ?? ''}@${btn.dataset.d ?? ''}`

    // Fill visible label and aria-label from JS — never in HTML
    label.textContent = email
    btn.setAttribute('aria-label', `Copiar ${email}`)

    // Center toast via GSAP (owns the full transform, no CSS conflict)
    if (toast) gsap.set(toast, { xPercent: -50, y: 8 })

    let hideTimer: ReturnType<typeof setTimeout> | null = null

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email)
        showToast()
      } catch {
        // Fallback: open mail client (rare — only on HTTP or old browsers)
        window.location.href = `mailto:${email}`
      }
    })

    function showToast(): void {
      if (!toast) return
      if (hideTimer) clearTimeout(hideTimer)

      gsap.killTweensOf(toast)
      gsap.to(toast, { opacity: 1, y: 0, duration: 0.2, ease: 'power2.out' })

      hideTimer = setTimeout(() => {
        gsap.to(toast, { opacity: 0, y: 8, duration: 0.25, ease: 'power2.in' })
      }, 2200)
    }
  }
</script>
