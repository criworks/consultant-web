---
import { SiteGrid } from '@/components/grid'
---

<section id="intro" class="relative min-h-dvh flex items-center justify-center overflow-hidden">
  <SiteGrid class="relative z-20 w-full">
    <div
      class="site-col-start-1 site-col-span-32 flex flex-col items-center px-4 py-32 text-center text-intro tracking-hero font-semibold"
    >
      <p class="leading-intro text-white" data-animate="intro-text">Sientes que todo está difuso</p>
      <div class="leading-intro mix-blend-overlay text-accent mt-6 flex flex-col items-center">
        <p data-animate="intro-text">Estás construyendo rápido, pero no se ve claro.</p>
        <p data-animate="intro-text">El producto funciona, pero aún no se siente bien.</p>
        <p data-animate="intro-text">La visión está ahí, pero no todos parecen entenderla.</p>
      </div>
    </div>
  </SiteGrid>
</section>
