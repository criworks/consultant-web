---
import { SiteGrid } from '../grid'
import { HeroHeader, HeroTitle, HeroCta } from './index'
---

<section id="hero" class="sticky top-0 h-dvh text-foreground overflow-hidden">
  <SiteGrid class="relative z-10 h-dvh grid-rows-[auto_1fr_auto] pb-4">
    <HeroHeader />

    <div
      class="site-col-start-1 site-col-span-16 flex min-h-0 flex-col justify-end lg:site-col-start-2 lg:site-col-span-10"
    >
      <div class="flex flex-col gap-10">
        <HeroTitle />
        <HeroCta />
      </div>
    </div>
  </SiteGrid>
</section>

<script>
  import { initGsap, shouldAnimateByPreference, createHeroTimeline } from '../../lib'

  const gsap = initGsap()

  if (shouldAnimateByPreference()) {
    createHeroTimeline({ gsap })
  }
</script>
