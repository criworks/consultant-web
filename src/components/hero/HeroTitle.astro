---
import { site } from '../../data'
---

<div class="flex flex-col gap-6">
  <h1 class="text-foreground">
    <span
      class="hero-title-line block text-[clamp(4rem,12vw,8.75rem)] leading-[0.9] tracking-[-0.02em]"
      data-animate="hero-title"
    >
      {site.hero.title}
    </span>
  </h1>
  <p class="max-w-[340px] text-lg leading-[1.3] text-foreground" data-animate="hero-sub">
    {site.hero.subtitle}
  </p>
</div>
